generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  username      String    @unique
  password      String
  name          String
  email         String?
  phone         String?
  role          String    @default("ASSOCIATE") // ADMIN or ASSOCIATE
  rank          String    @default("Client Adviser")
  memberId      String    @unique
  referredById  String?
  referredBy    User?     @relation("Referrals", fields: [referredById], references: [id])
  referrals     User[]    @relation("Referrals")
  walletBalance Float     @default(0)
  customDownline Int?
  customSalesGaj Float?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sales         Sale[]
  leads         Lead[]
  visitors      Visitor[]
  incentives    Incentive[]

  // Extended Profile Details
  gender          String?   @default("Male")
  avatarUrl       String?
  address         String?
  state           String?
  district        String?
  city            String?
  pincode         String?
  tahsil          String?
  villagePost     String?
  spouseName      String?
  bankName        String?
  accountNumber   String?
  ifscCode        String?
  accountHolder   String?
  upiId           String?
  nomineeName     String?
  nomineeRelation String?
  nomineePhone    String?
}

model Plot {
  id          String   @id @default(cuid())
  plotNumber  String   @unique
  projectName String   @default("Shree Karni City")
  location    String
  sizeGaj     Float
  pricePerGaj Float
  totalPrice  Float
  status      String   @default("AVAILABLE") // AVAILABLE, SOLD, RESERVED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sale        Sale?
}

model Sale {
  id         String   @id @default(cuid())
  plotId     String   @unique
  plot       Plot     @relation(fields: [plotId], references: [id])
  soldById   String
  soldBy     User     @relation(fields: [soldById], references: [id])
  buyerName  String
  buyerPhone String
  buyerEmail String?
  saleAmount Float
  saleDate   DateTime @default(now())
  createdAt  DateTime @default(now())
}

model Lead {
  id                String    @id @default(cuid())
  associateId       String?
  associate         User?     @relation(fields: [associateId], references: [id])
  name              String
  phone             String
  email             String?
  status            String    @default("NEW") // NEW, CONTACTED, SITE_VISIT_SCHEDULED, VISITED, NEGOTIATION, WON, LOST
  source            String?   @default("Website") // Website, WhatsApp, Walk-in, Referral, Meta Ads, 99acres, MagicBricks
  budget            String?   // e.g. 5-10 Lakhs, 10-20 Lakhs, 20-50 Lakhs, 50L+
  preferredSizeGaj   Float?
  preferredLocation String?   @default("Jaipur")
  plotInterest      String?
  notes             String?
  followUpDate      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Visitor {
  id             String    @id @default(cuid())
  associateId    String?
  associate      User?     @relation(fields: [associateId], references: [id])
  visitorName    String
  phone          String
  email          String?
  projectName    String?   @default("Shree Karni City")
  plotInterest   String?
  visitDate      DateTime  @default(now())
  timeSlot       String?   @default("10:00 AM - 12:00 PM")
  pickupLocation String?
  driverOrCab    String?
  feedback       String?
  rating         Int?      @default(5)
  status         String    @default("SCHEDULED") // SCHEDULED, IN_TRANSIT, COMPLETED, CANCELLED, NO_SHOW
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
}

model Incentive {
  id          String   @id @default(cuid())
  associateId String
  associate   User     @relation(fields: [associateId], references: [id])
  amount      Float
  type        String   // SALE, REFERRAL, BONUS, RANK_ACHIEVEMENT
  description String?
  status      String   @default("PENDING") // PENDING, APPROVED, PAID
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
